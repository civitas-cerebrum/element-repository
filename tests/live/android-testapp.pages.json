{
  "pages": [
    {
      "name": "Home",
      "platform": "android",
      "elements": [
        { "elementName": "grid", "selector": { "accessibility id": "home-grid" } },
        { "elementName": "gridByShortId", "selector": { "id": "home_grid" } },
        { "elementName": "gridByFullId", "selector": { "id": "com.civitas.testapp:id/home_grid" } },
        { "elementName": "gridByClassName", "selector": { "class name": "android.widget.GridView" } },
        { "elementName": "categoryTitles", "selector": { "id": "category_title" }, "list": true },
        { "elementName": "mediaTitleByText", "selector": { "text": "Media" } },
        { "elementName": "cardElements", "selector": { "accessibility id": "home-card-buttons" } },
        { "elementName": "cardAlerts", "selector": { "accessibility id": "home-card-alerts" } },
        { "elementName": "cardInteractions", "selector": { "accessibility id": "home-card-sortable" } },
        { "elementName": "cardMedia", "selector": { "accessibility id": "home-card-gallery" } },
        { "elementName": "cardEdgeCases", "selector": { "accessibility id": "home-card-longList" } }
      ]
    },
    {
      "name": "Category",
      "platform": "android",
      "elements": [
        { "elementName": "checkboxes", "selector": { "accessibility id": "category-item-checkboxes" } },
        { "elementName": "radio", "selector": { "accessibility id": "category-item-radiobuttons" } },
        { "elementName": "alerts", "selector": { "accessibility id": "category-item-alerts" } },
        { "elementName": "tall", "selector": { "accessibility id": "category-item-tall" } },
        { "elementName": "longList", "selector": { "accessibility id": "category-item-longList" } },
        { "elementName": "gallery", "selector": { "accessibility id": "category-item-gallery" } }
      ]
    },
    {
      "name": "Checkboxes",
      "platform": "android",
      "elements": [
        { "elementName": "checkboxUnchecked", "selector": { "accessibility id": "checkbox-unchecked" } },
        { "elementName": "checkboxChecked", "selector": { "accessibility id": "checkbox-checked" } },
        { "elementName": "toggleOff", "selector": { "accessibility id": "toggle-off" } },
        { "elementName": "toggleOn", "selector": { "accessibility id": "toggle-on" } },
        { "elementName": "toggleOffByShortId", "selector": { "id": "toggle_off" } },
        { "elementName": "toggleOffByFullId", "selector": { "id": "com.civitas.testapp:id/toggle_off" } },
        { "elementName": "toggleOffByUiAutomator", "selector": { "uiautomator": "new UiSelector().resourceId(\"com.civitas.testapp:id/toggle_off\")" } },
        { "elementName": "toggleOffByXpath", "selector": { "xpath": "//android.widget.Switch[@content-desc='toggle-off']" } },
        { "elementName": "toggleOffByText", "selector": { "text": "Toggle (off)" } },
        { "elementName": "checkboxes", "selector": { "class name": "android.widget.CheckBox" }, "list": true },
        { "elementName": "stateSummary", "selector": { "id": "checkbox_state_summary" } }
      ]
    },
    {
      "name": "Radio",
      "platform": "android",
      "elements": [
        { "elementName": "yes", "selector": { "accessibility id": "radio-yes" } },
        { "elementName": "impressive", "selector": { "id": "radio_impressive" } },
        { "elementName": "no", "selector": { "uiautomator": "new UiSelector().description(\"radio-no\")" } },
        { "elementName": "buttons", "selector": { "class name": "android.widget.RadioButton" }, "list": true }
      ]
    },
    {
      "name": "LongList",
      "platform": "android",
      "elements": [
