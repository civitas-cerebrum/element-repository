{
  "pages": [
    {
      "name": "SettingsHome",
      "platform": "android",
      "elements": [
        { "elementName": "generalByAccessibilityId", "selector": { "accessibility id": "android-only-general" } },
        { "elementName": "generalByPredicate", "selector": { "uiautomator": "new UiSelector().description(\"android-only-general\")" } },
        { "elementName": "generalByClassChain", "selector": { "xpath": "//android.widget.TextView[@content-desc='android-only-general']" } },
        { "elementName": "generalById", "selector": { "id": "com.example.android:id/general" } },
        { "elementName": "cells", "selector": { "class name": "android.widget.LinearLayout" }, "list": true },
        { "elementName": "privacyRow", "selector": { "accessibility id": "android-only-privacy" } },
        { "elementName": "settingsList", "selector": { "class name": "androidx.recyclerview.widget.RecyclerView" } },
        { "elementName": "rowButtons", "selector": { "class name": "android.widget.LinearLayout" }, "list": true }
      ]
    },
    {
      "name": "SettingsHome",
      "elements": [
        { "elementName": "generalByAccessibilityId", "selector": { "css": "[data-testid='web-only-general']" } },
        { "elementName": "generalByPredicate", "selector": { "css": "#web-only-general" } },
        { "elementName": "generalByClassChain", "selector": { "xpath": "//*[@id='web-only-general']" } },
        { "elementName": "generalById", "selector": { "css": "#web-only-general" } },
        { "elementName": "cells", "selector": { "css": "li.web-only-row" }, "list": true },
        { "elementName": "privacyRow", "selector": { "css": "#web-only-privacy" } },
        { "elementName": "settingsList", "selector": { "css": "ul.web-only-list" } },
        { "elementName": "rowButtons", "selector": { "css": "li.web-only-row > button" }, "list": true }
      ]
    },
    {
      "name": "SettingsHome",
      "platform": "ios",
      "elements": [
        { "elementName": "generalByAccessibilityId", "selector": { "accessibility id": "com.apple.settings.general" } },
        { "elementName": "generalByPredicate", "selector": { "predicate": "type == \"XCUIElementTypeButton\" AND name == \"com.apple.settings.general\"" } },
        { "elementName": "generalByClassChain", "selector": { "class chain": "**/XCUIElementTypeButton[`name == \"com.apple.settings.general\"`]" } },
        { "elementName": "generalById", "selector": { "id": "com.apple.settings.general" } },
        { "elementName": "cells", "selector": { "class name": "XCUIElementTypeCell" }, "list": true },
        { "elementName": "privacyRow", "selector": { "accessibility id": "com.apple.settings.privacyAndSecurity" } },
        { "elementName": "settingsList", "selector": { "predicate": "type IN {\"XCUIElementTypeTable\", \"XCUIElementTypeCollectionView\"}" } },
        { "elementName": "rowButtons", "selector": { "predicate": "type == \"XCUIElementTypeButton\" AND name BEGINSWITH \"com.apple.settings.\" AND NOT (name CONTAINS[c] \"account\") AND NOT (name CONTAINS[c] \"appleid\")" }, "list": true }
      ]
    }
  ]
}
